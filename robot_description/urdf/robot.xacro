<?xml version="1.0"?>
<robot name="robot" xmlns:xacro="http://www.ros.org/wiki/xacro">
    
    <!-- **********************************************************************
        [PROPERTIES]
    *********************************************************************** -->
    <xacro:property name="PI"           value="3.14159265"/>
    <xacro:property name="mesh_dir"     value="package://robot_description/meshes"/>


    <!-- **********************************************************************
        [ARG]
    *********************************************************************** -->
    <xacro:arg name="ns"                default="r1"/>


    <!-- **********************************************************************
        [CUSTOM COLOR]
    *********************************************************************** -->
    <material name="base_color">
        <color rgba="0.52 0.55 0.81 1.0"/>
    </material>

    <material name="wheel_color">
        <color rgba="0.15 0.15 0.15 1.0"/>
    </material>

    <material name="lidar_color">
        <color rgba="0.93 0.91 0.17 1.0"/>
    </material>


    <!-- ********************************************************************** 
        [LINKS]
    *********************************************************************** -->

    <!-- ───────────────────────────────────────────────────────────────────────
        [LINKS] Base Footprint
    ──────────────────────────────────────────────────────────────────────── -->
    <link name="$(arg ns)_base_footprint"/>


    <!-- ───────────────────────────────────────────────────────────────────────
        [LINKS] Base Link
    ──────────────────────────────────────────────────────────────────────── -->
    <link name="$(arg ns)_base_link">
        <visual>
            <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
            <geometry>
                <mesh filename="${mesh_dir}/base_link.STL" scale="1 1 1"/>
            </geometry>
            <material name="base_color"/>
        </visual>

        <collision>
            <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
            <geometry>
                <mesh filename="${mesh_dir}/base_link.STL" scale="1 1 1"/>
            </geometry>
        </collision>

        <inertial>
            <origin xyz="0.049 -0.002 0.219" rpy="0.0 0.0 0.0"/>
            <mass value="6.32"/>
            <inertia ixx="0.078" ixy="1.027E-05" ixz="-3.324E-05" 
                    iyy="0.089" iyz="4.051E-07" izz="0.059"/>
        </inertial>
    </link>

    <!-- ───────────────────────────────────────────────────────────────────────
        [LINKS] Wheel Left
    ──────────────────────────────────────────────────────────────────────── -->
    <link name="$(arg ns)_wheel_left_link">
        <visual>
            <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
            <geometry>
                <mesh filename="${mesh_dir}/wheel_left.STL" scale="1 1 1"/>
            </geometry>
            <material name="wheel_color"/>
        </visual>

        <collision>
            <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
            <geometry>
                <mesh filename="${mesh_dir}/wheel_left.STL" scale="1 1 1"/>
            </geometry>
        </collision>

        <inertial>
            <origin xyz="-0.014 0.001 -0.033" rpy="0.0 0.0 0.0"/>
            <mass value="0.7"/>
            <inertia ixx="0.001" ixy="7.908E-21" ixz="-3.057E-20" 
                    iyy="0.002" iyz="4.986E-20" izz="0.001"/>
        </inertial>
    </link>

    <!-- ───────────────────────────────────────────────────────────────────────
        [LINKS] Wheel Right
    ──────────────────────────────────────────────────────────────────────── -->
    <link name="$(arg ns)_wheel_right_link">
        <visual>
            <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
            <geometry>
                <mesh filename="${mesh_dir}/wheel_right.STL" scale="1 1 1"/>
            </geometry>
            <material name="wheel_color"/>
        </visual>

        <collision>
            <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
            <geometry>
                <mesh filename="${mesh_dir}/wheel_right.STL" scale="1 1 1"/>
            </geometry>
        </collision>

        <inertial>
            <origin xyz="-0.014 0.001 -0.033" rpy="0.0 0.0 0.0"/>
            <mass value="0.7"/>
            <inertia ixx="0.001" ixy="5.125E-22" ixz="-3.493E-20"
                     iyy="0.002" iyz="2.955E-22" izz="0.001"/>
        </inertial>
    </link>

    <!-- ───────────────────────────────────────────────────────────────────────
        [LINKS] Caster Left
    ──────────────────────────────────────────────────────────────────────── -->
    <link name="$(arg ns)_caster_left_link">
        <visual>
            <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
            <geometry>
                <mesh filename="${mesh_dir}/caster_left.STL" scale="1 1 1"/>
            </geometry>
            <material name="wheel_color"/>
        </visual>

        <collision>
            <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
            <geometry>
                <mesh filename="${mesh_dir}/caster_left.STL" scale="1 1 1"/>
            </geometry>
        </collision>

        <inertial>
            <origin xyz="-0.014 0.001 -0.033" rpy="0.0 0.0 0.0"/>
            <mass value="0.1"/>
            <inertia ixx="2.433E-05" ixy="3.222E-05" ixz="-2.152E-05" 
                    iyy="2.851E-05" iyz="3.766E-07" izz="2.982E-05"/>
        </inertial>
    </link>

    <!-- ───────────────────────────────────────────────────────────────────────
        [LINKS] Caster Right
    ──────────────────────────────────────────────────────────────────────── -->
    <link name="$(arg ns)_caster_right_link">
        <visual>
            <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
            <geometry>
                <mesh filename="${mesh_dir}/caster_right.STL" scale="1 1 1"/>
            </geometry>
            <material name="wheel_color"/>
        </visual>

        <collision>
            <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
            <geometry>
                <mesh filename="${mesh_dir}/caster_right.STL" scale="1 1 1"/>
            </geometry>
        </collision>

        <inertial>
            <origin xyz="-0.014 0.001 -0.033" rpy="0.0 0.0 0.0"/>
            <mass value="0.1"/>
            <inertia ixx="2.433E-05" ixy="3.222E-05" ixz="-2.152E-05" 
                    iyy="2.851E-05" iyz="3.766E-07" izz="2.982E-05"/>
        </inertial>
    </link>

    <!-- ───────────────────────────────────────────────────────────────────────
        [LINKS] Imu
    ──────────────────────────────────────────────────────────────────────── -->
    <link name="$(arg ns)_imu_link"/>

    <!-- ───────────────────────────────────────────────────────────────────────
        [LINKS] Lidar
    ──────────────────────────────────────────────────────────────────────── -->
    <link name="$(arg ns)_lidar_link">
        <visual>
            <origin xyz="0 0 -0.05" rpy="0 0 0"/>
            <geometry>
                <mesh filename="${mesh_dir}/lidar_hokuyo_ust10.stl" scale="1 1 1"/>
            </geometry>
            <material name="lidar_color"/>
        </visual>
    </link>

    <!-- ───────────────────────────────────────────────────────────────────────
        [LINKS] Camera
    ──────────────────────────────────────────────────────────────────────── -->
    <link name="$(arg ns)_camera_link">
        <visual>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <geometry>
                <mesh filename="${mesh_dir}/d435.dae" scale="1.1 1.1 1.1"/>
            </geometry>
        </visual>
    </link>


    <!-- ********************************************************************** 
        [JOINTS]
    *********************************************************************** -->

    <!-- ───────────────────────────────────────────────────────────────────────
        [JOINTS] Base
    ──────────────────────────────────────────────────────────────────────── -->
    <joint name="$(arg ns)_base_joint" type="fixed">
        <origin xyz="0.0 0.0 0.035" rpy="0.0 0.0 0.0"/>
        <parent link="$(arg ns)_base_footprint"/>
        <child link="$(arg ns)_base_link"/>
    </joint>

    <!-- ───────────────────────────────────────────────────────────────────────
        [JOINTS] Wheel Left
    ──────────────────────────────────────────────────────────────────────── -->
    <joint name="$(arg ns)_wheel_left_joint" type="continuous">
        <origin xyz="0.155 0.144 0.044" rpy="0.0 0.0 0.0"/>
        <parent link="$(arg ns)_base_link"/>
        <child link="$(arg ns)_wheel_left_link"/>
        <axis xyz="0 1 0"/>
        <limit effort="10.0" velocity="10.0"/>
    </joint>

    <!-- ───────────────────────────────────────────────────────────────────────
        [JOINTS] Wheel Right
    ──────────────────────────────────────────────────────────────────────── -->
    <joint name="$(arg ns)_wheel_right_joint" type="continuous">
        <origin xyz="0.155 -0.144 0.044" rpy="0.0 0.0 0.0"/>
        <parent link="$(arg ns)_base_link"/>
        <child link="$(arg ns)_wheel_right_link"/>
        <axis xyz="0 1 0"/>
        <limit effort="10.0" velocity="10.0"/>
    </joint>

    <!-- ───────────────────────────────────────────────────────────────────────
        [JOINTS] Caster Left
    ──────────────────────────────────────────────────────────────────────── -->
    <joint name="$(arg ns)_caster_left_joint" type="fixed">
        <origin xyz="-0.1 0.085 0.038" rpy="0.0 0.0 0.0"/>
        <parent link="$(arg ns)_base_link"/>
        <child link="$(arg ns)_caster_left_link"/>
    </joint>

    <!-- ───────────────────────────────────────────────────────────────────────
        [JOINTS] Caster Right
    ──────────────────────────────────────────────────────────────────────── -->
    <joint name="$(arg ns)_caster_right_joint" type="fixed">
        <origin xyz="-0.1 -0.085 0.038" rpy="0.0 0.0 0.0"/>
        <parent link="$(arg ns)_base_link"/>
        <child link="$(arg ns)_caster_right_link"/>
    </joint>

    <!-- ───────────────────────────────────────────────────────────────────────
        [JOINTS] Imu
    ──────────────────────────────────────────────────────────────────────── -->
    <joint name="$(arg ns)_imu_joint" type="fixed">
        <origin xyz="0.0 0.0 0.0" rpy="0 0 0"/>
        <parent link="$(arg ns)_base_link"/>
        <child link="$(arg ns)_imu_link"/>
    </joint>

    <!-- ───────────────────────────────────────────────────────────────────────
        [JOINTS] Lidar
    ──────────────────────────────────────────────────────────────────────── -->
    <joint name="$(arg ns)_lidar_joint" type="fixed">
        <origin xyz="0.318 0 0.134" rpy="0 0 0"/>
        <parent link="$(arg ns)_base_link"/>
        <child link="$(arg ns)_lidar_link"/>
    </joint>

    <!-- ───────────────────────────────────────────────────────────────────────
        [JOINTS] Camera
    ──────────────────────────────────────────────────────────────────────── -->
    <joint name="$(arg ns)_camera_joint" type="fixed">
        <origin xyz="0.08 0 1.168" rpy="0 0 0"/>
        <parent link="$(arg ns)_base_link"/>
        <child link="$(arg ns)_camera_link"/>
    </joint>


    <!-- ********************************************************************** 
        [SENSORS]
    *********************************************************************** -->

    <!-- ───────────────────────────────────────────────────────────────────────
        [SENSORS] Imu
    ──────────────────────────────────────────────────────────────────────── -->
    <gazebo reference="$(arg ns)_imu_link">
        <sensor name="imu_sensor" type="imu"  >
            <ignition_frame_id>$(arg ns)_imu_link</ignition_frame_id>
            <always_on>1</always_on>
            <update_rate>50</update_rate>
            <visualize>false</visualize>
            <topic>$(arg ns)/imu</topic>
            <imu>
                <enable_orientation>1</enable_orientation>
                <angular_velocity>
                    <x>
                        <noise type="gaussian">
                            <mean>0</mean>
                            <stddev>0.009</stddev>
                            <bias_mean>0.00075</bias_mean>
                            <bias_stddev>0.005</bias_stddev>
                            <dynamic_bias_stddev>0.00002</dynamic_bias_stddev>
                            <dynamic_bias_correlation_time>400.0</dynamic_bias_correlation_time>
                            <precision>0.00025</precision>
                        </noise>
                    </x>
                    <y>
                        <noise type="gaussian">
                            <mean>0</mean>
                            <stddev>0.009</stddev>
                            <bias_mean>0.00075</bias_mean>
                            <bias_stddev>0.005</bias_stddev>
                            <dynamic_bias_stddev>0.00002</dynamic_bias_stddev>
                            <dynamic_bias_correlation_time>400.0</dynamic_bias_correlation_time>
                            <precision>0.00025</precision>
                        </noise>
                    </y>
                    <z>
                        <noise type="gaussian">
                            <mean>0</mean>
                            <stddev>0.009</stddev>
                            <bias_mean>0.00075</bias_mean>
                            <bias_stddev>0.005</bias_stddev>
                            <dynamic_bias_stddev>0.00002</dynamic_bias_stddev>
                            <dynamic_bias_correlation_time>400.0</dynamic_bias_correlation_time>
                            <precision>0.00025</precision>
                        </noise>
                    </z>
                </angular_velocity>
                <linear_acceleration>
                    <x>
                        <noise type="gaussian">
                            <mean>0</mean>
                            <stddev>0.021</stddev>
                            <bias_mean>0.05</bias_mean>
                            <bias_stddev>0.0075</bias_stddev>
                            <dynamic_bias_stddev>0.000375</dynamic_bias_stddev>
                            <dynamic_bias_correlation_time>175.0</dynamic_bias_correlation_time>
                            <precision>0.005</precision>
                        </noise>
                    </x>
                    <y>
                        <noise type="gaussian">
                            <mean>0</mean>
                            <stddev>0.021</stddev>
                            <bias_mean>0.05</bias_mean>
                            <bias_stddev>0.0075</bias_stddev>
                            <dynamic_bias_stddev>0.000375</dynamic_bias_stddev>
                            <dynamic_bias_correlation_time>175.0</dynamic_bias_correlation_time>
                            <precision>0.005</precision>
                        </noise>
                    </y>
                    <z>
                        <noise type="gaussian">
                            <mean>0</mean>
                            <stddev>0.021</stddev>
                            <bias_mean>0.05</bias_mean>
                            <bias_stddev>0.0075</bias_stddev>
                            <dynamic_bias_stddev>0.000375</dynamic_bias_stddev>
                            <dynamic_bias_correlation_time>175.0</dynamic_bias_correlation_time>
                            <precision>0.005</precision>
                        </noise>
                    </z>
                </linear_acceleration>
            </imu>
        </sensor>
    </gazebo>

    <!-- ───────────────────────────────────────────────────────────────────────
        [SENSORS] Lidar
    ──────────────────────────────────────────────────────────────────────── -->
    <gazebo reference="$(arg ns)_lidar_link">
        <sensor name='gpu_lidar' type='gpu_lidar'>
        <ignition_frame_id>$(arg ns)_lidar_link</ignition_frame_id> 
        <update_rate>10</update_rate>
        <alwaysOn>1</alwaysOn>
        <visualize>false</visualize>
        <topic>/$(arg ns)/lidar</topic>
        <ray>
            <scan>
                <horizontal>
                    <samples>180</samples>
                    <resolution>1</resolution>
                    <min_angle>${-PI/2}</min_angle>
                    <max_angle>${PI/2}</max_angle>
                </horizontal>
            </scan>
            <range>
                <min>0.5</min>
                <max>10.0</max>
                <resolution>0.017453</resolution>
            </range>
            <noise>
                <type>gaussian</type>
                <mean>0.0</mean>
                <stddev>0.01</stddev>
            </noise>
        </ray>
        </sensor>
    </gazebo>

    <!-- ───────────────────────────────────────────────────────────────────────
        [SENSORS] Camera
    ──────────────────────────────────────────────────────────────────────── -->
    <!-- <gazebo reference="$(arg ns)_camera_link">
        <sensor name="rgbd_camera" type="rgbd_camera">
            <ignition_frame_id>$(arg ns)_camera_link</ignition_frame_id>
            <always_on>1</always_on>
            <update_rate>5</update_rate>
            <visualize>0</visualize>
            <camera name="rgbd_camera_frame">
                <horizontal_fov>1.3962634</horizontal_fov>
                <lens>
                    <intrinsics>
                        <fx>277.1</fx>
